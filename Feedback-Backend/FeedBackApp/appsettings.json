{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    // SEC-02: Set via environment variable CONNECTIONSTRINGS__DEFAULTCONNECTION in production
    // or use dotnet user-secrets in development: dotnet user-secrets set "ConnectionStrings:DefaultConnection" "..."
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=FeedBackAppDb;Trusted_Connection=true;TrustServerCertificate=true;"
  },
  "JwtSettings": {
    // SEC-02: NEVER commit a real key here. Set via environment variable JWTSETTINGS__KEY in production.
    // Generate a strong key: openssl rand -base64 48
    // dotnet user-secrets set "JwtSettings:Key" "<your-key>"
    "Key": "REPLACE_ME_WITH_A_STRONG_SECRET_KEY_MIN_32_CHARS",
    "Issuer": "FeedBackApp",
    "Audience": "FeedBackAppUsers",
    "ExpiryMinutes": "1440"
  },
  "Smtp": {
    // SEC-02: Set Smtp:Host, Smtp:Username, Smtp:Password via environment variables or user-secrets
    "Host": "",
    "Port": "587",
    "Username": "",
    "Password": "",
    "From": "noreply@feedbackapp.com",
    "UseSsl": "true"
  },
  "CorsOrigins": "",
  "AllowedHosts": "*",
  "AdminSeed": {
    // SEC-02: Override Password and Email via environment variables in production:
    // ADMINSEED__PASSWORD, ADMINSEED__EMAIL, ADMINSEED__USERNAME
    "Username": "admin",
    "Email": "admin@feedbackapp.com",
    "Password": "REPLACE_ME_WITH_STRONG_ADMIN_PASSWORD"
  },
  "AnalyticsEmail": {
    "MaxRecipients": 25,
    "MaxTextSamplesPerQuestion": 20,
    "MaxTextCharsPerSample": 400,
    "SmtpAttemptsPerRecipient": 3,
    "SmtpRetryBaseSeconds": 2
  }
}